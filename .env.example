# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# Never set this to True in production.
DJANGO_DEBUG=True

# Comma-separated. Example for production: DJANGO_ALLOWED_HOSTS=debuggersblog.onrender.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, must include scheme. Example: https://debuggersblog.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: overrides the default SQLite database.
# Example (Postgres): postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Set to False if the host already terminates TLS in a way that causes redirect loops.
DJANGO_SECURE_SSL_REDIRECT=True
